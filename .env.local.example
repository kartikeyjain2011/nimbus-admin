# Clerk Backend API — must be the SAME Clerk application instance used by
# frontendnimbuz.vercel.app, otherwise the Users page will show zero/different users.
# Get this from https://dashboard.clerk.com -> API Keys
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY

# RAWG Game Database API — used to populate the Game Library page with the
# real catalog (same source frontendnimbuz.vercel.app uses).
NEXT_PUBLIC_RAWG_API_KEY=YOUR_RAWG_API_KEY

# Razorpay — same account used by frontendnimbuz's /dashboard/upgrade checkout.
# RAZORPAY_KEY_SECRET must NEVER be prefixed with NEXT_PUBLIC_ and must never
# be exposed to the browser.
RAZORPAY_KEY_ID=rzp_live_or_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
